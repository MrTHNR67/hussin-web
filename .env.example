# انسخ هذا الملف باسم .env ثم أضف مفتاحك الخاص
# Claude API: server only. Do not add a real key to GitHub or public files.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Shared limit for panel and invoice requests; application limits, not billing caps.
CLAUDE_USER_DAILY_LIMIT=10
CLAUDE_GLOBAL_DAILY_LIMIT=100
GOOGLE_CLIENT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
# Shared with Supabase Vault (siyaj_alert_job_secret); never put in the browser.
SIYAJ_JOB_SECRET=
PORT=3000
SIYAJ_DATA_DIR=
DATABASE_URL=
# Optional raw database password when DATABASE_URL does not include one.
DATABASE_PASSWORD=
# Optional PEM CA certificate if required by the database connection.
DATABASE_SSL_CA=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=siyaj-media
# البلاغات والشكاوى: الوجهة الافتراضية لفريق الصيانة (تعمل بدون إعداد أي شيء).
SIYAJ_COMPLAINT_EMAIL=shathaalbaraa67@gmail.com
# اختياري: بدون هذه القيم يفتح التطبيق بريد الزائر بالنص الجاهز لفريق الصيانة.
# معها يرسل السيرفر البلاغ مباشرة عبر SMTP.
SIYAJ_SMTP_HOST=
SIYAJ_SMTP_PORT=587
SIYAJ_SMTP_SECURE=
SIYAJ_SMTP_USER=
SIYAJ_SMTP_PASS=
SIYAJ_SMTP_FROM=
# --- Cloud / scaling (all optional) -----------------------------------------
# Weather microservice. Leave empty to keep the weather code in-process.
WEATHER_SERVICE_URL=
# Comma-separated emails that receive the "admin" role (e.g. you@example.com).
SIYAJ_ADMIN_EMAILS=
# Session idle timeout in days (absolute expiry stays at 30 days).
SESSION_IDLE_DAYS=7
# Login brute-force protection.
LOGIN_FAIL_LIMIT=10
LOGIN_FAIL_MINUTES=15
LOGIN_LOCK_MINUTES=15
